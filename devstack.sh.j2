#!/usr/bin/env bash
# DevStack project script for {{ project_name }}
# Run from the project root: ./devstack <command>

set -euo pipefail

PROJECT_NAME="{{ project_name }}"
COMPOSE="docker compose{% for p in profiles %} --profile {{ p }}{% endfor %}"

case "${1:-help}" in
  up)
    echo "Starting $PROJECT_NAME..."
    $COMPOSE up -d
    ;;
  build)
    echo "Rebuilding ${2:-all} services..."
    if [ -n "${2:-}" ]; then
      $COMPOSE build --no-cache "$2"
    else
      $COMPOSE build --no-cache
    fi
    $COMPOSE up -d
    ;;
  down)
    echo "Stopping $PROJECT_NAME..."
    $COMPOSE down
    ;;
  rebuild)
    echo "Tearing down and rebuilding $PROJECT_NAME from scratch..."
    $COMPOSE down --rmi all
    $COMPOSE up -d --build
    ;;
  add)
    shift
    devstack add "$@"
    ;;
  restart)
    $COMPOSE down && $COMPOSE up -d
    ;;
  logs)
    $COMPOSE logs -f "${2:-}"
    ;;
  exec)
    shift
    $COMPOSE exec "$@"
    ;;
  shell)
    $COMPOSE exec backend bash
    ;;
  migrate)
    $COMPOSE exec backend alembic upgrade head
    ;;
  status)
    $COMPOSE ps
    ;;
  db)
    shift
    case "${1:-help}" in
      migrate)
        $COMPOSE exec backend alembic upgrade head
        ;;
      reset)
        echo "Resetting database for $PROJECT_NAME..."
        $COMPOSE stop postgres
        $COMPOSE rm -f postgres
        docker volume rm "${PROJECT_NAME}_postgres_data" 2>/dev/null || true
        $COMPOSE up -d postgres
        echo "Waiting for postgres..."
        sleep 5
        $COMPOSE exec backend alembic upgrade head
        echo "Database reset complete."
        ;;
      shell)
        $COMPOSE exec postgres psql -U devstack -d "$PROJECT_NAME"
        ;;
      dump)
        OUT="${2:-${PROJECT_NAME}_dump.sql}"
        $COMPOSE exec -T postgres pg_dump -U devstack -d "$PROJECT_NAME" > "$OUT"
        echo "Dumped to $OUT"
        ;;
      *)
        echo "Usage: ./devstack db {migrate|reset|shell|dump [file]}"
        exit 1
        ;;
    esac
    ;;
  env)
    echo "=== backend/.env ==="
    cat backend/.env 2>/dev/null || echo "(not found)"
    echo ""
    echo "=== frontend/.env.local ==="
    cat frontend/.env.local 2>/dev/null || echo "(not found)"
    ;;
  *)
    echo "Usage: ./devstack {up|build [svc]|rebuild|down|restart|add <svc...>|logs [svc]|exec <svc> <cmd>|shell|migrate|status|db <cmd>|env}"
    exit 1
    ;;
esac
